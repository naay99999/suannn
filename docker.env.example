# Secrets for `docker compose`. Copy to `.env` in the repository root; never commit the copy.

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64url'))"
COMMERCE_SECRET=
RESEND_API_KEY=re_replace_with_your_api_key
AUTH_EMAIL_FROM=Suannn <auth@example.com>

# Optional. Set all four together to enable Stripe Checkout (restricted rk_test_ key).
# Forward webhooks with: stripe listen --forward-to localhost:6767/api/v1/webhooks/stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# STRIPE_SUCCESS_URL=http://localhost:4183/checkout/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=http://localhost:4183/checkout/cancel

# Optional. Set all five together to enable the media library (product and farm images).
# Use a bucket of its own; R2_PUBLIC_URL is the bucket's public URL, not the S3 endpoint.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
