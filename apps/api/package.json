{
  "name": "api",
  "version": "1.0.50",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "auth:generate": "bun --env-file=.env.local ./node_modules/.bin/auth generate --config src/plugins/auth/cli.ts --output src/database/schema/auth.ts --yes",
    "auth:bootstrap-owner": "bun --env-file=.env.local src/cli/bootstrap-owner.ts",
    "db:generate": "bun --env-file=.env.local ./node_modules/.bin/drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "bun --env-file=.env.local ./node_modules/.bin/drizzle-kit migrate --config drizzle.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "test": "bun test"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@elysia/openapi": "^1.4.16",
    "@elysiajs/cors": "^1.4.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "elysia": "1.4.30",
    "postgres": "^3.4.9",
    "resend": "^6.28.1"
  },
  "devDependencies": {
    "@workspace/config": "workspace:*",
    "auth": "^1.7.5",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  },
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    }
  }
}
