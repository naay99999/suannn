HOST=0.0.0.0
PORT=6767
# Total graceful shutdown budget, including pool closes (1–300000 ms).
SHUTDOWN_TIMEOUT_MS=30000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/suannn
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Required. Set a unique key with at least 32 random bytes encoded as unpadded base64url.
COMMERCE_SECRET=
BETTER_AUTH_URL=http://localhost:6767
# Origin used for storefront callback URLs and token-free order links in email.
STOREFRONT_URL=http://localhost:5183
ADMIN_URL=http://localhost:5184
RESEND_API_KEY=re_replace_with_your_api_key
AUTH_EMAIL_FROM=Suannn <auth@example.com>
# Optional. Set all four values together to enable hosted Stripe Checkout.
# Use separate Stripe sandboxes and restricted keys for local development and CI.
# Keep the API key and webhook signing secret in a deployment secrets vault.
# The restricted key needs Checkout Sessions create/read, PaymentIntents read,
# and Refunds create/read permissions only.
# STRIPE_API_KEY=rk_test_replace_with_restricted_key
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# The success URL can include {CHECKOUT_SESSION_ID}; both URLs must use the
# configured STOREFRONT_URL origin. Redirects do not confirm or cancel orders.
# STRIPE_SUCCESS_URL=http://localhost:5183/checkout/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=http://localhost:5183/checkout/cancel
# Register checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, refund.created,
# refund.updated, and refund.failed on the Stripe webhook endpoint.
# Optional. Defaults to 365 days.
# Required in production. Enable only for headers the deployment proxy overwrites.
# TRUSTED_PROXY_HEADERS=x-forwarded-for,x-real-ip
# Required when NODE_ENV=production. Comma-separate exact frontend origins.
# CORS_ORIGINS=https://store.example.com,https://admin.example.com
