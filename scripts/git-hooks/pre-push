#!/bin/sh
# Runs the API integration suite before pushing to main or staging, since CI skips it
# on staging. Install with `bun run hooks:install`; skip once with `git push --no-verify`.
#
# Uses TEST_DATABASE_URL, defaulting to the local suannn_test database. The suite resets
# that database and refuses any database whose name does not end in _test.

run=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/staging) run=1 ;;
  esac
done

[ "$run" = 1 ] || exit 0

export TEST_DATABASE_URL="${TEST_DATABASE_URL:-postgresql://$(whoami)@127.0.0.1:5432/suannn_test}"
echo "pre-push: running API integration tests (git push --no-verify to skip)"

if ! bun run test:integration; then
  echo "pre-push: integration tests failed; push aborted" >&2
  exit 1
fi
