# Production environment for compose.prod.yaml on Dokploy.
# Paste the filled-in values into the compose app's Environment tab; never commit them.
# For `docker compose` on your machine use docker.env.example instead.
#
# The storefront and admin VITE_* values are not read here: they are embedded in the
# web image at build time from GitHub repository variables (see docs/deployment.md).
# NODE_ENV, HOST, PORT, BETTER_AUTH_URL, and CORS_ORIGINS are derived by compose.

# ── Deployment ────────────────────────────────────────────────────────────────

# production (default) requires a Stripe rk_live_ key; staging requires rk_test_.
# Both keep the production hardening (HTTPS, CORS, trusted proxy headers).
DEPLOY_ENV=production
# Image tag to run: the branch name (main or staging), or a commit SHA to roll back.
IMAGE_TAG=main

# ── Required ──────────────────────────────────────────────────────────────────

# Internal connection URL of the Dokploy PostgreSQL service.
DATABASE_URL=postgresql://postgres:password@host:5432/suannn

# HTTPS origins without a trailing slash. They must match the GitHub repository
# variables API_URL, STOREFRONT_URL, and ADMIN_URL exactly.
API_URL=https://api.example.com
STOREFRONT_URL=https://example.com
ADMIN_URL=https://admin.example.com

# Generate fresh production values; changing either later invalidates existing sessions or tokens.
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64url'))"
COMMERCE_SECRET=

RESEND_API_KEY=
# Sender on a domain verified in Resend.
AUTH_EMAIL_FROM=Suannn <auth@example.com>

# ── Media library (Cloudflare R2) ─────────────────────────────────────────────
# All five or none. Without them uploads return 503 and products and farms cannot be
# published, so production needs them. Use a production-only bucket; R2_PUBLIC_URL is
# the bucket's custom domain, not r2.dev or the *.r2.cloudflarestorage.com endpoint.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=suannn-prod
R2_PUBLIC_URL=https://media.example.com

# ── Stripe Checkout (optional) ────────────────────────────────────────────────
# All four or none. Restricted keys only: rk_live_ for production, rk_test_ for staging. Use the signing
# secret of the https://<API_URL>/api/v1/webhooks/stripe endpoint. Both return URLs
# must use the STOREFRONT_URL origin.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# STRIPE_SUCCESS_URL=https://example.com/checkout/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=https://example.com/checkout/cancel

# ── Proxy (optional) ──────────────────────────────────────────────────────────
# Defaults to x-real-ip (set by Traefik). Use cf-connecting-ip behind the Cloudflare proxy.
# TRUSTED_PROXY_HEADERS=x-real-ip

# ── Server-side tracking (optional) ───────────────────────────────────────────
# Each group is all-or-none; see apps/api/README.md → "Tracking and ads".
# PostHog: project key (phc_…) and ingestion host, e.g. https://us.i.posthog.com.
POSTHOG_API_KEY=
POSTHOG_HOST=
# Meta Conversions API. Leave the test event code empty in production.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
# TikTok Events API. Leave the test event code empty in production.
TIKTOK_PIXEL_CODE=
TIKTOK_EVENTS_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=
# Google Ads conversion uploads; the login customer id is optional (manager account).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Receives delivery-failure and spend-sync alerts.
TRACKING_ALERT_EMAIL=

# ── Marketing reports (optional) ──────────────────────────────────────────────
# Read-only tokens for the admin Marketing page; each group is all-or-none and separate
# from the tracking credentials above. See apps/api/README.md → "Marketing page".
META_ADS_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_MARKETING_ACCESS_TOKEN=
# PostHog reads use POSTHOG_HOST (default https://us.posthog.com); setting POSTHOG_HOST also
# requires POSTHOG_API_KEY, because the tracking group above is all-or-none.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
